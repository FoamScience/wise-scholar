{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "scholar": {
      "type": "remote",
      "url": "http://127.0.0.1:8321/mcp",
      "enabled": true
    }
  },
  "agent": {
    "tutor-interview": {
      "mode": "primary",
      "description": "wise-scholar tutor: course interview",
      "prompt": "{file:./wise_scholar/prompts/core.md}\n\n{file:./wise_scholar/prompts/interview.md}",
      "permission": { "*": "deny", "scholar_*": "allow" }
    },
    "tutor-placement": {
      "mode": "primary",
      "description": "wise-scholar tutor: placement check",
      "prompt": "{file:./wise_scholar/prompts/core.md}\n\n{file:./wise_scholar/prompts/placement.md}",
      "permission": { "*": "deny", "scholar_*": "allow" }
    },
    "tutor-lesson": {
      "mode": "primary",
      "description": "wise-scholar tutor: lesson",
      "prompt": "{file:./wise_scholar/prompts/core.md}\n\n{file:./wise_scholar/prompts/lesson.md}",
      "permission": {
        "*": "deny",
        "scholar_*": "allow",
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  }
}
